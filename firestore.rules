rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      // Replace with YOUR admin user UID (Firebase Console > Authentication > Users)
      allow write: if request.auth != null && request.auth.uid == "PASTE_YOUR_ADMIN_UID_HERE";
    }
  }
}
